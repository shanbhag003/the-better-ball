# Copy to .env (never commit it) and fill in from your Microsoft Foundry project.
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL=<model deployment name, e.g. gpt-4.1-mini>
# Optional backup deployment, used automatically if the primary fails (rate limit, outage).
FOUNDRY_FALLBACK_MODEL=
# Comma-separated origins allowed to call the API (the web app).
CORS_ORIGINS=http://localhost:5173
